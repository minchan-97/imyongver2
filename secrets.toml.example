# 이 파일을 .streamlit/secrets.toml 로 복사해서 값 채우기 (git에 올리지 말 것)
# Streamlit Cloud 배포 시에는 앱 설정 → Secrets 에 같은 내용 붙여넣기

SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_KEY = "service_role 키"   # Project Settings → API → service_role (secret)
APP_PASSWORD = "앱 접속 비밀번호"

# 넣어두면 각 탭의 키 입력칸이 사라지고 자동으로 쓰임 (비워두면 예전처럼 입력칸 표시)
OPENAI_API_KEY = "sk-..."
BRAVE_API_KEY  = "BSA..."
# (선택) 페이지 스캔 모델. 비우면 gpt-4o-mini. 표·손글씨가 많아 정확도가 아쉬우면 "gpt-4o"
# OPENAI_SCAN_MODEL = "gpt-4o"
# (선택) 손글씨 판독 모델. 비우면 gpt-4o
# OPENAI_HANDWRITING_MODEL = "gpt-4o"
# (선택) 자동 분류 모델. 비우면 gpt-4o-mini
# OPENAI_TAG_MODEL = "gpt-4o-mini"
